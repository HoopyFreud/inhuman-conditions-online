{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "inhuman-conditions-online",
	"compatibility_date": "2026-08-08",
	"compatibility_flags": [
		"nodejs_als"
	],
	"pages_build_output_dir": ".svelte-kit/cloudflare",
	"durable_objects": {
		"bindings": [
			{
				"name": "IHC_SERVER_NAMESPACE",
				"class_name": "inhuman-conditions-session-worker_IHCGameServer"
			}
		]
	}
}
